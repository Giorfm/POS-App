# POS & Dashboard Configuration
# Demo Mode: Kosongkan variabel Supabase untuk menjalankan aplikasi langsung dalam Demo Mode (IndexedDB Dexie).
# Supabase Mode: Isi variabel di bawah ini untuk menghubungkan aplikasi ke instance Supabase live.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mode Bisnis Default: "retail" atau "fnb" (dapat diubah juga di Pengaturan Bisnis di Dashboard)
NEXT_PUBLIC_DEFAULT_BUSINESS_TYPE=retail
